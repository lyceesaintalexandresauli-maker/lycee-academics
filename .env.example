SECRET_KEY=
# Flask connects to Supabase Postgres. Copy the Session Pooler URI from the
# Supabase dashboard's Connect panel; URL-encode reserved characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres?sslmode=require
# Optional Supabase API settings. These are not used by the current Flask routes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Compatibility alias for clients that still read SUPABASE_KEY; keep in sync if used.
SUPABASE_KEY=
# Keep this server-only. Never use it in browser code or commit its real value.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
MAX_CONTENT_LENGTH=104857600
PUBLIC_BASE_URL=https://school.example.org
# Required to authenticate RFID scan and attendance-status requests. Generate a unique
# random secret for this deployment and configure the same value on the reader.
# RFID_DEVICE_CLASS is optional. Leave it blank to accept all classes and show school-wide totals.
RFID_DEVICE_TOKEN=replace-with-a-long-random-secret
RFID_DEVICE_CLASS=
# Optional safe room limits, keyed by the exact room name used for meetings.
# Occupancy warnings use checked-in meeting participants; environmental readings need a sensor integration.
ROOM_CAPACITY_LIMITS={"Boardroom":12,"Lab 1":20}

# Optional Microsoft Graph calendar and Teams video meeting integration. Register
# an app with Calendars.ReadWrite application permission and grant tenant admin
# consent. Use a dedicated, Teams-enabled mailbox. Meeting managers can start a
# Teams conference from a meeting detail page; set this true to create a Teams
# link automatically for every scheduled/rescheduled meeting.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_CALENDAR_MAILBOX=
MS_GRAPH_TIME_ZONE=South Africa Standard Time
MS_GRAPH_CREATE_TEAMS_MEETINGS=false

# Optional OpenAI-compatible recommendation provider. Disabled by default.
# The assistant retrieves and authorizes data locally; only aggregate counts are
# sent for optional suggestions. The user's raw question and student identifiers
# are never sent to the provider.
AI_PROVIDER_ENABLED=false
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=

# Optional parent email alerts (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Optional parent SMS alerts (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFICATION_TIMEOUT=10
